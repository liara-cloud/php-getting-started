# Ignore Composer dependencies
/vendor/

# Ignore environment variables (sensitive data)
.env

# Ignore IDE/editor-specific files
*.idea/
*.vscode/
*.sublime-project
*.sublime-workspace
nbproject/

# Ignore log files and temporary files
*.log
*.tmp
*.temp

# Ignore macOS-specific files
.DS_Store

# Ignore Windows-specific files
Thumbs.db

# Ignore PHP session files
sess_*

# Ignore cache files
cache/
*.cache

# Ignore uploaded files (if you don't want them in the repo)
/uploads/
/storage/

# Ignore composer.lock if you prefer not to commit it (optional)
# composer.lock

# Ignore PHPUnit or testing-related files
/phpunit.xml
/phpunit.xml.dist
/tests/_output/

# Ignore any other custom directories or files
# /custom-directory/